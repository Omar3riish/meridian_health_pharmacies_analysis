# Copy this file to .streamlit/secrets.toml and fill in your own credentials.
# NEVER commit secrets.toml to GitHub.

[postgres]
url = "postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE"

[postgres.tables]
sales = "fact_sales"
customers = "dim_customers"
products = "dim_products"
stores = "dim_stores"
inventory = "stock_condition_log"
employees = "dim_employees"
prescriptions = "prescriptions_log"
categories = "categories"
suppliers = "suppliers"
